{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "OPENFRAMEWORKS_DIR": "$env{OPENFRAMEWORKS_DIR}"
      }
    },
    {
      "name": "macos-x86_64",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64"
      }
    },
    {
      "name": "macos-arm64",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "rpi-native",
      "inherits": "base",
      "cacheVariables": {
        "OPENFRAMEWORKS_PLATFORM": "$env{OPENFRAMEWORKS_PLATFORM}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-x86_64",
      "configurePreset": "macos-x86_64"
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64"
    },
    {
      "name": "rpi-native",
      "configurePreset": "rpi-native"
    }
  ]
}
